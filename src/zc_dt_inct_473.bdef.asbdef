projection;
use draft;

define behavior for ZC_DT_INCT_473 alias Incident
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _History { create; with draft; }
}

define behavior for ZC_DT_HISTORY_473 alias History
{
  use update;
  use delete;

  use association _Incident { with draft; }
}